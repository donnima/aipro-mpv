# Application
# Public app URL used by Auth.js and absolute links (e.g. http://localhost:3000)
AUTH_URL=
# Cryptographically random secret, minimum 32 bytes. Generate: openssl rand -base64 32
AUTH_SECRET=
# Optional override for health endpoint version string
APP_VERSION=
# Optional commit SHA for health endpoint (CI usually injects GITHUB_SHA / VERCEL_GIT_COMMIT_SHA)
COMMIT_SHA=

# Database (Phase 1 / T-002) — Neon pooled URL for the app; never commit a real value
DATABASE_URL=
# Neon direct (non-pooled) URL for Prisma migrations
DATABASE_URL_UNPOOLED=

# Google OAuth (Phase 1 / T-003)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email provider for magic links (Phase 1 / T-003) — Resend or Postmark
EMAIL_FROM=
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# Object storage (Phase 3) — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# AI providers (Phase 6+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
