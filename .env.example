# Application
# Public API base URL (backend only — not the customer UI). WordPress is the primary website (ADR-0021).
# Production: https://api.urunlytics.com  |  Local: http://localhost:3000
# Brand/domains: docs/decisions/FOUNDER-BRAND-AND-DOMAINS.md
AIPRO_API_PUBLIC_URL=
# Optional override for health endpoint version string
APP_VERSION=
# Optional commit SHA for health endpoint (CI usually injects GITHUB_SHA / VERCEL_GIT_COMMIT_SHA)
COMMIT_SHA=

# Database (Phase 1 / TASK-002 Part B) — Neon pooled URL for the app; never commit a real value
DATABASE_URL=
# Neon direct (non-pooled) URL for Prisma migrations
DATABASE_URL_UNPOOLED=

# WordPress integration (ADR-0021) — server-side only; never expose private keys to the browser
# WordPress site: https://urunlytics.com — site identifier used in identity mapping and JWT claims
WORDPRESS_SITE_ID=
# JWT verification public key (PEM) or JWKS URL for tokens minted by aipro-platform-bridge
# Production audience should target api.urunlytics.com when implemented
AIPRO_JWT_ISSUER=
AIPRO_JWT_AUDIENCE=
AIPRO_JWT_PUBLIC_KEY=
# Optional: private key only on the WordPress server / plugin config — do not put WP private keys here unless this process mints tokens in local mock mode
# AIPRO_JWT_PRIVATE_KEY=

# SUPERSEDED (ADR-0005 → ADR-0021): Auth.js / magic link / Google OAuth app credentials are not used.
# AUTH_URL=
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# EMAIL_FROM=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# Object storage (Phase 3) — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# AI providers (Phase 6+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
